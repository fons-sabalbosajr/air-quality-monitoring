# ═══════════════════════════════════════════════════════════════
# AQM SERVER — Environment Variables (.env)
# Copy to .env and fill in real values. NEVER commit .env.
# ═══════════════════════════════════════════════════════════════

# ── Core ──
PORT=3001
NODE_ENV=production

# Optional: force Node's DNS resolvers (comma-separated). Only needed on
# machines where Node can't detect system DNS and mongodb+srv:// lookups
# fail with "querySrv ECONNREFUSED". Leave blank otherwise.
DNS_SERVERS=

# ── CORS (comma-separated allowed origins for production) ──
# Example: https://aqm.yourdomain.com,https://www.yourdomain.com
CORS_ORIGIN=

# ── Rate Limiting ──
RATE_WINDOW_MS=60000
RATE_MAX=120

# ── Reverse proxy ──
# Trust X-Forwarded-* from Nginx so client IPs / HTTPS detection are correct.
# Defaults to 1 hop when NODE_ENV=production. Set 0 to disable.
TRUST_PROXY=1

# ── External partner API (/api/v1) ──
# Issue keys with:  node scripts/apiKeys.js create --name "Partner"
# HTTPS is required by default in production; set 0 only for local testing.
EXTERNAL_API_REQUIRE_HTTPS=1
EXTERNAL_API_DEFAULT_RATE_LIMIT=60
EXTERNAL_API_LOG_TTL_DAYS=30
EXTERNAL_API_CACHE_TTL_MS=60000

# ── Google Sheets published CSV URLs ──
SHEET_PM10_MEYCAUAYAN_URL=
SHEET_PM25_MEYCAUAYAN_URL=
SHEET_PM10_ZAMBALES_URL=
SHEET_PM25_ZAMBALES_URL=
SHEET_PM10_CLARK_URL=
SHEET_PM10_SAN_FERNANDO_URL=

# ── MongoDB Atlas ──
MONGO_URI=
MONGO_DB_NAME=db-air_quality_monitoring
MONGO_COLLECTION_SERIES=air_data
MONGO_COLLECTION_META=air_data_meta
MONGO_COLLECTION_STATION=station_meta

# ── Ingestion Schedule ──
INGEST_CRON=*/15 * * * *
INGEST_TZ=Asia/Manila
INGEST_ON_START=1

# ── Cache ──
CACHE_TTL_MS=60000
SHEET_CACHE_TTL_MS=20000
SHEET_FETCH_TIMEOUT_MS=15000
SHEET_FETCH_RETRIES=3
BACKUP_CRON=*/1 * * * *
LATEST_REFRESH_WAIT_MS=8000

# VNNOX / iframe display compatibility for /nlex.
# Example: VNNOX_FRAME_ANCESTORS="'self' https: http:"
VNNOX_FRAME_ANCESTORS="'self' https: http:"
DISABLE_DISK_CACHE=0
CACHE_DIR=

# ── Station Metadata ──
STATION_NAME=
STATION_ADDRESS=
STATION_LAT=
STATION_LON=

# ── Microsoft Graph API (SharePoint/OneDrive – optional) ──
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# ── Weather API ──
OWM_API_KEY=

# ── Email (Gmail SMTP – optional) ──
EMAIL_USER=
EMAIL_PASS=
