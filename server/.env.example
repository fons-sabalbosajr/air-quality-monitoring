# ═══════════════════════════════════════════════════════════════
# AQM SERVER — Environment Variables (.env)
# Copy to .env and fill in real values. NEVER commit .env.
# ═══════════════════════════════════════════════════════════════

# ── Core ──
PORT=3001
NODE_ENV=production

# ── CORS (comma-separated allowed origins for production) ──
# Example: https://aqm.yourdomain.com,https://www.yourdomain.com
CORS_ORIGIN=

# ── Rate Limiting ──
RATE_WINDOW_MS=60000
RATE_MAX=120

# ── Google Sheets published CSV URLs ──
SHEET_PM10_MEYCAUAYAN_URL=
SHEET_PM25_MEYCAUAYAN_URL=
SHEET_PM10_ZAMBALES_URL=
SHEET_PM25_ZAMBALES_URL=
SHEET_PM10_CLARK_URL=
SHEET_PM10_SAN_FERNANDO_URL=

# ── MongoDB Atlas ──
MONGO_URI=
MONGO_DB_NAME=db-air_quality_monitoring
MONGO_COLLECTION_SERIES=air_data
MONGO_COLLECTION_META=air_data_meta
MONGO_COLLECTION_STATION=station_meta

# ── Ingestion Schedule ──
INGEST_CRON=*/15 * * * *
INGEST_TZ=Asia/Manila
INGEST_ON_START=1

# ── Cache ──
CACHE_TTL_MS=60000
SHEET_CACHE_TTL_MS=300000
DISABLE_DISK_CACHE=0
CACHE_DIR=

# ── Station Metadata ──
STATION_NAME=
STATION_ADDRESS=
STATION_LAT=
STATION_LON=

# ── Microsoft Graph API (SharePoint/OneDrive – optional) ──
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# ── Weather API ──
OWM_API_KEY=

# ── Email (Gmail SMTP – optional) ──
EMAIL_USER=
EMAIL_PASS=
